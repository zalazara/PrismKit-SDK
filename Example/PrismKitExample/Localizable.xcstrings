{
  "sourceLanguage": "en",
  "strings": {
    "%@. Designed for everyday use with premium materials and a two-year warranty. Free shipping and 30-day returns included.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. مصمم للاستخدام اليومي بمواد فاخرة وضمان لمدة عامين. يشمل شحنًا مجانيًا وإرجاعًا خلال 30 يومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Für den Alltag entworfen, mit Premium-Materialien und zwei Jahren Garantie. Kostenloser Versand und 30 Tage Rückgabe inklusive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Diseñado para el uso diario con materiales premium y dos años de garantía. Incluye envío gratis y devoluciones de 30 días."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Diseñado para el uso diario con materiales premium y dos años de garantía. Incluye envío gratis y devoluciones de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Conçu pour un usage quotidien avec des matériaux premium et une garantie de deux ans. Livraison gratuite et retours sous 30 jours inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Progettato per l'uso quotidiano con materiali premium e due anni di garanzia. Spedizione gratuita e resi entro 30 giorni inclusi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。プレミアム素材と2年保証で、毎日の使用のために設計されています。送料無料、30日間の返品可。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 프리미엄 소재로 일상 사용을 위해 설계되었으며 2년 보증이 제공됩니다. 무료 배송 및 30일 반품 포함."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Projetado para o uso diário com materiais premium e dois anos de garantia. Frete grátis e devoluções em 30 dias incluídos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。采用高级材质，专为日常使用设计，提供两年保修。含免费配送和 30 天退货。"
          }
        }
      }
    },
